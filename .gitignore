.DS_Store
.claude/worktrees/
.claude/settings.local.json
.env
.superpowers/

# Node / Next.js / OpenNext / Wrangler build outputs
# packages/web/node_modules/**
node_modules/
packages/web/**/node_modules
packages/web/**/dist

websites/**/node_modules
websites/**/dist
websites/**/package-lock.json
websites/**/.next

# .next/
# .open-next/
# .wrangler/
*.tsbuildinfo
*.log

# pnpm workspace + package builds
packages/*/dist/

# generated by packages/web/packages/themes/scripts/build-theme-data.mjs
# packages/web/packages/themes/src/theme-data.ts

.vercel

# Xcode per-user state
**/xcuserdata/
*.xcuserstate

# Xcode build output (xcodebuild -derivedDataPath ./build)
packages/apple/**/build/

# Python bytecode from tools/
__pycache__/

# From agentictoolkit's ignore list. Its `packages/web/packages/themes/` entry is
# deliberately not here: it hid a package that had left ATK for this repo, and
# `themes` lives here again. Its blanket `Package.resolved` / xcworkspace
# xcshareddata ignores are not here either: this repo commits the workspace's
# resolved SwiftPM pins so every checkout builds the same dependency graph.
.worktrees/
.turbo/
.next/
next-env.d.ts
.pnpm-store/
**/.build/
DerivedData/
*.pyc
graphify-out/
.claude/scheduled_tasks.lock
