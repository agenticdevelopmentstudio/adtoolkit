{
  "name": "@agenticdevelopertoolkit/controls",
  "version": "0.1.0",
  "description": "Reusable controls for agenticdevelopertoolkit (filtered-list, source-code-panel, logging-panel, user-settings, search-dialog, appearance-mode-toggle, orb-row, dev-banner).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "comment:exports": "`development` → src (submodule checkouts have no dist/; consumers resolve this condition in every mode). Otherwise dist.",
  "exports": {
    "./appearance-mode-toggle": {
      "types": "./dist/appearance-mode-toggle/index.d.ts",
      "development": "./src/appearance-mode-toggle/index.ts",
      "import": "./dist/appearance-mode-toggle/index.js"
    },
    "./dev-banner": {
      "types": "./dist/dev-banner/index.d.ts",
      "development": "./src/dev-banner/index.ts",
      "import": "./dist/dev-banner/index.js"
    },
    "./filtered-list": {
      "types": "./dist/filtered-list/index.d.ts",
      "development": "./src/filtered-list/index.ts",
      "import": "./dist/filtered-list/index.js"
    },
    "./logging-panel": {
      "types": "./dist/logging-panel/index.d.ts",
      "development": "./src/logging-panel/index.ts",
      "import": "./dist/logging-panel/index.js"
    },
    "./orb-row": {
      "types": "./dist/orb-row/index.d.ts",
      "development": "./src/orb-row/index.ts",
      "import": "./dist/orb-row/index.js"
    },
    "./search-dialog": {
      "types": "./dist/search-dialog/index.d.ts",
      "development": "./src/search-dialog/index.ts",
      "import": "./dist/search-dialog/index.js"
    },
    "./source-code-panel": {
      "types": "./dist/source-code-panel/index.d.ts",
      "development": "./src/source-code-panel/index.ts",
      "import": "./dist/source-code-panel/index.js"
    },
    "./user-settings": {
      "types": "./dist/user-settings/index.d.ts",
      "development": "./src/user-settings/index.ts",
      "import": "./dist/user-settings/index.js"
    },
    "./appearance-mode-toggle/styles.css": {
      "development": "./src/appearance-mode-toggle/styles/appearance-mode-toggle.css",
      "default": "./dist/appearance-mode-toggle/styles/appearance-mode-toggle.css"
    },
    "./dev-banner/styles.css": {
      "development": "./src/dev-banner/styles/dev-banner.css",
      "default": "./dist/dev-banner/styles/dev-banner.css"
    },
    "./filtered-list/styles.css": {
      "development": "./src/filtered-list/styles/filtered-list.css",
      "default": "./dist/filtered-list/styles/filtered-list.css"
    },
    "./logging-panel/styles.css": {
      "development": "./src/logging-panel/styles/logging-panel.css",
      "default": "./dist/logging-panel/styles/logging-panel.css"
    },
    "./orb-row/styles.css": {
      "development": "./src/orb-row/styles/orb-row.css",
      "default": "./dist/orb-row/styles/orb-row.css"
    },
    "./search-dialog/styles.css": {
      "development": "./src/search-dialog/styles/search-dialog.css",
      "default": "./dist/search-dialog/styles/search-dialog.css"
    },
    "./source-code-panel/styles.css": {
      "development": "./src/source-code-panel/styles/source-code-panel.css",
      "default": "./dist/source-code-panel/styles/source-code-panel.css"
    },
    "./user-settings/styles.css": {
      "development": "./src/user-settings/styles.css",
      "default": "./dist/user-settings/styles.css"
    }
  },
  "comment:lint": "This package was historically excluded from the `lint` gate for pre-existing type rot (implicit-any handler params, a couple of bare `React` namespace references). Checked again here rather than carried over on faith: with this package's current version floors, `tsc --noEmit` runs clean in this workspace as of the 2026-08 move. Left unlabelled would be worse than this note going stale — if `lint` starts failing again, fix or re-document it, don't silently drop this comment.",
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run build:css",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:css": "node ../../copy-css.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenticdevelopertoolkit/model": "workspace:*",
    "shiki": "^1.24.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agenticdevelopertoolkit/themes": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "jsdom": "^29.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
