{
  "name": "@agentic-toolkit/bitbag",
  "version": "0.1.0",
  "description": "bitbag — his persona, voice, avatar rig, and chat surface. Mounts on any site that links @agenticdevelopertoolkit.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./mark": {
      "types": "./dist/mark.d.ts",
      "development": "./src/mark.ts",
      "import": "./dist/mark.js"
    },
    "./css/bitbag-dock.css": {
      "development": "./src/styles/bitbag-dock.css",
      "default": "./dist/css/bitbag-dock.css"
    }
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run build:css",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:css": "mkdir -p dist/css && cp src/styles/*.css dist/css/",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@agenticdevelopertoolkit/avatar": "*",
    "@agenticdevelopertoolkit/chat": "*",
    "@agenticdevelopertoolkit/themes": "*",
    "@agenticdevelopertoolkit/viewport": "*",
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "//devDependencies": "The four @agenticdevelopertoolkit/* entries are peer deps above — consumers supply them; these workspace:* devDependencies exist only so this package can build and test itself. bitbag is the one package that owns this crossing on purpose: everything else in this repo reaches persona vocabulary through bitbag's re-exports, which is what keeps the persona toolkit out of every other consumer's shipped graph.",
  "devDependencies": {
    "@agenticdevelopertoolkit/avatar": "workspace:*",
    "@agenticdevelopertoolkit/chat": "workspace:*",
    "@agenticdevelopertoolkit/themes": "workspace:*",
    "@agenticdevelopertoolkit/viewport": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "gsap": "^3.13.0",
    "jsdom": "^29.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
