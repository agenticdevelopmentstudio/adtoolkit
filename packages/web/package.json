{
  "name": "agenticdevelopertoolkit",
  "version": "0.1.0",
  "description": "Agentic developer toolkit — shared React + TypeScript packages for persona chat, the ADH client, and the Agentic Cookbook family sites. pnpm monorepo.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticdevelopmentstudio/agenticdevelopertoolkit.git"
  },
  "homepage": "https://github.com/agenticdevelopmentstudio/agenticdevelopertoolkit#readme",
  "bugs": {
    "url": "https://github.com/agenticdevelopmentstudio/agenticdevelopertoolkit/issues"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:types": "pnpm -r --if-present --workspace-concurrency=1 run build:types",
    "dev": "pnpm -r --parallel --if-present run dev",
    "test": "vitest run && pnpm -r --if-present run test",
    "lint": "python3 ../../tools/check_boundaries_test.py && python3 ../../tools/check_boundaries.py && pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.16",
      "esbuild": "^0.28.1"
    }
  }
}
